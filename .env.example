# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env (đã có trong .gitignore).

# ---------- Database PostgreSQL (dịch vụ db) ----------
POSTGRES_DB=dapchuot
POSTGRES_USER=dapchuot
# Mật khẩu database: chuỗi ngẫu nhiên dài, ví dụ tạo bằng: openssl rand -hex 24
POSTGRES_PASSWORD=doi-thanh-mat-khau-database-that

# ---------- Tài khoản trang /admin ----------
ADMIN_USERNAME=admin
# Tối thiểu 12 ký tự; ngắn hơn thì trang admin bị tắt.
ADMIN_PASSWORD=doi-thanh-mat-khau-admin-that

# ---------- Proxy ----------
# true khi chạy sau ngrok / reverse proxy (lấy IP thật từ X-Forwarded-For, bật cookie Secure qua HTTPS).
# Để false nếu người chơi truy cập thẳng cổng 3000.
TRUST_PROXY=true
